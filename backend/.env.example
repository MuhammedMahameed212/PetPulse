# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-petpulse-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (sqlite, mssql, or postgres)
DB_ENGINE=sqlite
# Uncomment and fill below when switching to SQL Server or PostgreSQL:
# DB_NAME=PetPulseDB
# DB_USER=sa
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=1433

# External APIs (Milestones 6 & 7)
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

